# One-shot CPU seeder for the shared Runpod training cache. It contains no
# customer code, data, model weights, or provider credentials.
FROM python:3.10-slim-bookworm@sha256:db6ee5170ebce0f4d165af242e8e77addc08bd9ffc37e8b1815752cf027aa4f8

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SGL_RUNTIME_VERSION=v0.5.0 \
    SGL_RUNTIME_ROOT=/workspace/sgl-train/runtime/v0.5.0

RUN apt-get update -y \
 && apt-get install -y --no-install-recommends ca-certificates curl git libgomp1 \
 && rm -rf /var/lib/apt/lists/*

COPY scripts/seed-volume-runtime.sh /usr/local/bin/seed-volume-runtime
ENTRYPOINT ["/usr/local/bin/seed-volume-runtime"]
